<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cumt.zongzuo.community.mapper.TagMapper">

    <select id="selectTagsByArticleId" resultType="cumt.zongzuo.community.entity.Tag">
        SELECT t.*
        FROM tag t
                 INNER JOIN article_tag at ON t.id = at.tag_id
        WHERE at.article_id = #{articleId}
    </select>

    <select id="selectIdsByNames" resultType="java.lang.Long">
        SELECT id
        FROM tag
        WHERE name IN
        <foreach collection="names" item="name" open="(" separator="," close=")">
            #{name}
        </foreach>
        ORDER BY id
    </select>

</mapper>
